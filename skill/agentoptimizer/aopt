#!/usr/bin/env bash
# The skill's command. `aopt <command>` runs the core CLI; `aopt python ...` runs Python
# with the optimizer runtime (for analysis scripts), with this folder's aoptcore importable.
# The interpreter: $AOPT_PYTHON if set (the benchmark's sandbox sets it), else the skill's
# own uv environment, created on first use.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -n "${AOPT_PYTHON:-}" ]]; then
  py=("$AOPT_PYTHON")
else
  command -v uv >/dev/null || { echo "aopt needs uv: https://docs.astral.sh/uv/" >&2; exit 1; }
  py=(uv run --quiet --project "$here" python)
fi
export PYTHONPATH="$here/scripts${PYTHONPATH:+:$PYTHONPATH}"
if [[ "${1:-}" == "python" ]]; then
  shift
  exec "${py[@]}" "$@"
fi
exec "${py[@]}" "$here/scripts/aopt.py" "$@"
